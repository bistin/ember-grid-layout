{
  "name": "ember-grid-layout",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "description": "Small description for ember-grid-layout goes here",
  "keywords": [
    "ember-addon"
  ],
  "repository": "",
  "license": "MIT",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.9",
    "ember-modifier": "^4.2.0"
  },
  "engines": {
    "node": ">= 18"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2,
    "app-js": {
      "./components/grid-item.js": "./dist/_app_/components/grid-item.js",
      "./components/grid-layout.js": "./dist/_app_/components/grid-layout.js",
      "./modifiers/position.js": "./dist/_app_/modifiers/position.js",
      "./utils/index.js": "./dist/_app_/utils/index.js"
    }
  },
  "homepage": "https://bistin.github.io/ember-grid-layout",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/preset-typescript": "^7.26.0",
    "@embroider/addon-dev": "^5.0.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/ember": "^4.0.11",
    "@types/ember__destroyable": "^4.0.5",
    "@types/ember__test-helpers": "^2.9.1",
    "babel-eslint": "^10.1.0",
    "rollup": "^4.28.1",
    "tslib": "^2.8.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*",
    "./test-support": "./dist/test-support/index.js",
    "./addon-main.cjs": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "prepublishOnly": "rollup --config",
    "start": "rollup --config --watch",
    "test": "echo 'Addon does not have tests, run tests in test-app'"
  }
